<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign Up - SwapSkill</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fff5f8, #ffe1eb);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .signup-container {
            width: 100%;
            max-width: 950px;
            background: white;
            border-radius: 25px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 20px 50px rgba(231, 84, 128, 0.18);
        }

        /* LEFT SIDE */

        .signup-left {
            width: 45%;
            background: linear-gradient(145deg, #e75480, #f58ba8);
            color: white;
            padding: 55px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .logo {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 35px;
        }

        .signup-left h1 {
            font-size: 40px;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .signup-left p {
            font-size: 16px;
            line-height: 1.7;
            opacity: 0.95;
        }

        .benefits {
            margin-top: 30px;
        }

        .benefit {
            margin: 15px 0;
            font-size: 15px;
        }

        /* RIGHT SIDE */

        .signup-right {
            width: 55%;
            padding: 45px 50px;
        }

        .signup-right h2 {
            color: #333;
            font-size: 30px;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #777;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 17px;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: bold;
            color: #444;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            outline: none;
            font-size: 14px;
            transition: 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #e75480;
            box-shadow: 0 0 0 3px rgba(231, 84, 128, 0.08);
        }

        .signup-button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 25px;
            background: #e75480;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 8px;
            transition: 0.3s;
        }

        .signup-button:hover {
            background: #d94370;
            transform: translateY(-2px);
        }

        .login-text {
            text-align: center;
            margin-top: 20px;
            color: #777;
            font-size: 14px;
        }

        .login-text a {
            color: #e75480;
            text-decoration: none;
            font-weight: bold;
        }

        .home-link {
            text-align: center;
            margin-top: 12px;
        }

        .home-link a {
            color: #888;
            text-decoration: none;
            font-size: 13px;
        }

        /* MOBILE */

        @media (max-width: 750px) {

            .signup-container {
                flex-direction: column;
            }

            .signup-left,
            .signup-right {
                width: 100%;
            }

            .signup-left {
                padding: 35px;
            }

            .signup-left h1 {
                font-size: 30px;
            }

            .signup-right {
                padding: 35px;
            }
        }
    </style>
</head>

<body>

    <div class="signup-container">

        <!-- LEFT SECTION -->

        <div class="signup-left">

            <div class="logo">
                SwapSkill
            </div>

            <h1>
                Start your skill-sharing journey.
            </h1>

            <p>
                Create your account and connect with
                people who can teach you something new
                while learning from your own skills.
            </p>

            <div class="benefits">

                <div class="benefit">
                    ✓ Share the skills you know
                </div>

                <div class="benefit">
                    ✓ Discover new skills
                </div>

                <div class="benefit">
                    ✓ Find suitable skill matches
                </div>

                <div class="benefit">
                    ✓ Connect and learn together
                </div>

            </div>

        </div>


        <!-- RIGHT SECTION -->

        <div class="signup-right">

            <h2>
                Create Account
            </h2>

            <p class="subtitle">
                Join the SwapSkill community today.
            </p>

            <form id="signupForm">

                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        placeholder="Enter your full name"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        placeholder="Create a password"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="skill">
                        Skill You Can Teach
                    </label>

                    <input
                        type="text"
                        id="skill"
                        placeholder="Example: Java, Python, Drawing"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="learn">
                        Skill You Want to Learn
                    </label>

                    <input
                        type="text"
                        id="learn"
                        placeholder="Example: Web Development"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="signup-button"
                >
                    Create Account
                </button>

            </form>


            <p class="login-text">
                Already have an account?
                <a href="login.html">Login</a>
            </p>

            <div class="home-link">
                <a href="index.html">
                    ← Back to Home
                </a>
            </div>

        </div>

    </div>


    <script src="js/signup.js"></script>

</body>
</html>